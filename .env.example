# Application
PORT=3000
LOG_LEVEL=info
TIMEZONE=Europe/Stockholm
PUBLIC_BASE_URL=https://bot.example.com

# PostgreSQL
POSTGRES_DB=ckuni
POSTGRES_USER=ckuni
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ckuni:change-me@postgres:5432/ckuni

# Discord Developer Portal
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Cloudflare Tunnel (optional but recommended for home-server deployment)
# Create a remotely-managed tunnel in Cloudflare and paste only the tunnel token here.
# Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Strava integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_STATE_SECRET=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Current until Strava switches base URL in 2027
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
