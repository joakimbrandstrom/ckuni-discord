# Application
PORT=3000
LOG_LEVEL=info
TIMEZONE=Europe/Stockholm

# Optional Zwift boundary; no live provider is currently approved.
ZWIFT_ENABLED=false
ZWIFT_PROVIDER=none
ZWIFT_TIMEOUT_MS=1000
ZWIFT_CACHE_TTL_MS=60000
ZWIFT_MIN_INTERVAL_MS=5000

# PostgreSQL
POSTGRES_DB=ckuni
POSTGRES_USER=ckuni
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ckuni:change-me@postgres:5432/ckuni

# Discord Developer Portal
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Role IDs for Ride Leader and Admin authorization.
# Obtain from Discord: Server Settings → Roles → right-click role → Copy Role ID.
# Leave empty to allow all server members to manage rides (development/testing).
DISCORD_RIDE_LEADER_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_BOT_ROLE_ID=
DISCORD_CK_UNI_RIDER_ID=
DISCORD_GUEST_ROLE_ID=

DISCORD_WELCOME_CHANNEL_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_ZWIFT_RIDE_CHANNEL_ID=
DISCORD_GENERAL_CHANNEL_ID=

# Cloudflare Tunnel (optional but recommended for home-server deployment)
# Create a remotely-managed tunnel in Cloudflare and paste only the tunnel token here.
# Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=
