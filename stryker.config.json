{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/config.ts",
    "!src/env.ts",
    "!src/db/**/*.ts",
    "!src/discord/register-commands.ts",
    "!src/strava/create-webhook.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 60
  }
}
