{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "tsx --test test/auth.test.ts test/card.test.ts test/reminders.test.ts test/time.test.ts"
  },
  "mutate": [
    "src/rides/time.ts",
    "src/rides/reminder-thresholds.ts",
    "src/rides/card.ts",
    "src/discord/auth.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 60
  }
}
