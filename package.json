{
  "name": "ckuni-discord",
  "version": "0.1.0",
  "private": true,
  "description": "CK UNI digital cycling clubhouse for Discord and Zwift",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "commands:register": "tsx src/discord/register-commands.ts",
    "test": "tsx --test --test-concurrency=1 $(find test -name '*.test.ts' -print)",
    "test:integration": "tsx --test --test-concurrency=1 $(find test/integration -name '*.test.ts' -print)",
    "coverage": "c8 --reporter=text --reporter=lcov --all --src=src --extension=.ts --exclude-after-remap --check-coverage --lines=70 --branches=70 --functions=70 --statements=70 tsx --test --test-concurrency=1 $(find test -name '*.test.ts' -print)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "mutation": "stryker run"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "fastify": "^5.12.3",
    "luxon": "^3.0.0",
    "pg": "^8.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@stryker-mutator/core": "10.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
